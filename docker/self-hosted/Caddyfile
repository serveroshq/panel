# The self-hosted panel's web server: FrankenPHP (Caddy with PHP built in).
#
# The panel answers on SERVEROS_DOMAIN and each workspace on its own
# subdomain of it (acme.panel.example.com), so DNS needs both
# SERVEROS_DOMAIN and *.SERVEROS_DOMAIN pointing here. Each name gets its
# own Let's Encrypt certificate the first time it's visited (on-demand
# TLS), once the panel says the name is its own: /api/internal/tls-check,
# which only answers on the loopback address below.
#
# Behind a Cloudflare Tunnel (SERVEROS_TUNNEL=cloudflare), cloudflared hands
# requests on over plain HTTP and Cloudflare does HTTPS, so plain HTTP
# serves the panel instead of sending visitors to HTTPS. The entrypoint sets
# SERVEROS_HTTP and ACME_EMAIL_OPTION.
{
	skip_install_trust
	{$ACME_EMAIL_OPTION}
	{$CADDY_GLOBAL_OPTIONS}

	on_demand_tls {
		ask http://127.0.0.1:8081/api/internal/tls-check
	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

(panel) {
	root * /app/public
	encode zstd br gzip
	php_server
}

https:// {
	tls {
		on_demand
	}
	import panel
}

(http-redirect) {
	redir https://{host}{uri} permanent
}

(http-serve) {
	import panel
}

http:// {
	import http-{$SERVEROS_HTTP:redirect}
}

# Only from inside this container: the certificate check above and the
# health check.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	import panel
}

{$CADDY_EXTRA_CONFIG}
